# Copy this file to `.env` and fill in your key. NEVER commit your real .env —
# it holds secrets. (.env is git-ignored; .env.example is the safe template.)
#
# You only need the ONE key that matches LLM_MODEL in config.py:
#   claude-* -> ANTHROPIC_API_KEY
#   gpt-*    -> OPENAI_API_KEY
#   gemini/* -> GEMINI_API_KEY

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional: override the model here instead of editing config.py
# APPLY_LLM_MODEL=claude-sonnet-5
